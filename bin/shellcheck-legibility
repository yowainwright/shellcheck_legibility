#!/usr/bin/env bash

set -u -o pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

use_native_engine() {
  [[ "${SHELLCHECK_LEGIBILITY_ENGINE:-}" == "bash" ]] && return
  [[ -x "$ROOT_DIR/.build/shellcheck-legibility" ]] || return 0
  exec "$ROOT_DIR/.build/shellcheck-legibility" "$@"
}

use_native_engine "$@"

# shellcheck disable=SC1091
# shellcheck source=../lib/defaults.bash
source "$ROOT_DIR/lib/defaults.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/util.bash
source "$ROOT_DIR/lib/util.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/rules.bash
source "$ROOT_DIR/lib/rules.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/config.bash
source "$ROOT_DIR/lib/config.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/cli.bash
source "$ROOT_DIR/lib/cli.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/files.bash
source "$ROOT_DIR/lib/files.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/cache.bash
source "$ROOT_DIR/lib/cache.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/lint.bash
source "$ROOT_DIR/lib/lint.bash"
# shellcheck disable=SC1091
# shellcheck source=../lib/output.bash
source "$ROOT_DIR/lib/output.bash"

# shellcheck disable=SC2034
CACHE_SOURCES=("${BASH_SOURCE[0]}" "$ROOT_DIR"/lib/*.bash)
main "$@"
