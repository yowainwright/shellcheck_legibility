#!/usr/bin/env bash
set -euo pipefail

STAGE_DIR=""

usage() {
  printf 'usage: %s VERSION TARGET OUTPUT\n' "${BASH_SOURCE[0]}" >&2
  return 2
}

validate_version() {
  local version="${1:?}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && return
  printf 'invalid release version: %s\n' "$version" >&2
  exit 2
}

validate_target() {
  local target="${1:?}"
  case "$target" in
    darwin-arm64 | darwin-amd64 | linux-arm64 | linux-amd64)
      ;;
    *)
      printf 'invalid release target: %s\n' "$target" >&2
      exit 2
      ;;
  esac
}

validate_arguments() {
  if [[ "$#" -ne 3 ]]; then
    usage
    exit 2
  fi
  validate_version "$1"
  validate_target "$2"
}

write_bundle() {
  local version="${1:?}"
  local bundle_path="${2:?}"
  local target="${3:?}"
  export GOCACHE="$ROOT_DIR/.build/go-cache"
  export GOTMPDIR="$ROOT_DIR/.build/tmp"
  mkdir -p "$GOCACHE" "$GOTMPDIR"
  CGO_ENABLED=0 GOOS="${target%-*}" GOARCH="${target#*-}" \
    go -C "$ROOT_DIR" build -buildvcs=false -trimpath \
    -ldflags "-s -w -X main.version=$version" -o "$bundle_path" ./cmd/shellcheck-legibility
}

validate_bundle() {
  local bundle_path="${1:?}"
  local version="${2:?}"
  local target="${3:?}"
  [[ "$target" == "$(go env GOOS)-$(go env GOARCH)" ]] || return 0
  local reported_version
  reported_version="$($bundle_path --version)"
  if [[ "$reported_version" != "$version" ]]; then
    printf 'bundled version %s does not match release version %s\n' \
      "$reported_version" "$version" >&2
    exit 1
  fi
}

write_license_files() {
  local stage_dir="${1:?}"
  mkdir -p "$stage_dir/LICENSES"
  cp "$ROOT_DIR/LICENSE" "$stage_dir/LICENSE"
  cp "$ROOT_DIR/LICENSE" "$stage_dir/LICENSES/shellcheck-legibility"
  cp "$(go env GOROOT)/LICENSE" "$stage_dir/LICENSES/go"
  write_dependency_license "$stage_dir" mvdan.cc/sh/v3 mvdan-sh
  write_dependency_license "$stage_dir" github.com/pelletier/go-toml/v2 go-toml
  write_dependency_license "$stage_dir" go.yaml.in/yaml/v3 go-yaml
}

write_dependency_license() {
  local stage_dir="${1:?}" module="${2:?}" name="${3:?}"
  local module_dir
  module_dir="$(go -C "$ROOT_DIR" list -m -f '{{.Dir}}' "$module")"
  cp "$module_dir/LICENSE" "$stage_dir/LICENSES/$name"
  [[ ! -f "$module_dir/NOTICE" ]] || cp "$module_dir/NOTICE" "$stage_dir/LICENSES/$name-NOTICE"
}

set_archive_timestamps() {
  local stage_dir="${1:?}"
  touch -t 197001010000 \
    "$stage_dir" \
    "$stage_dir/shellcheck-legibility" \
    "$stage_dir/LICENSE" \
    "$stage_dir/LICENSES" \
    "$stage_dir/LICENSES/"*
}

cleanup() {
  [[ -n "$STAGE_DIR" ]] || return 0
  rm -rf "$STAGE_DIR"
}

initialize_release_stage() {
  local output="${1:?}"
  local output_dir
  output_dir="$(dirname "$output")"
  mkdir -p "$output_dir"
  output_dir="$(cd "$output_dir" && pwd)"
  STAGE_DIR="$(mktemp -d "$output_dir/.shellcheck-legibility.XXXXXX")"
  trap cleanup EXIT
}

main() {
  local version="${1:-}"
  local output="${3:-}"
  local bundle_path

  ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  validate_arguments "$@"
  initialize_release_stage "$output"
  bundle_path="$STAGE_DIR/shellcheck-legibility"
  write_bundle "$version" "$bundle_path" "$2"
  validate_bundle "$bundle_path" "$version" "$2"
  write_license_files "$STAGE_DIR"
  set_archive_timestamps "$STAGE_DIR"
  export COPYFILE_DISABLE=1
  tar -czf "$output" -C "$STAGE_DIR" shellcheck-legibility LICENSE LICENSES
}

main "$@"
